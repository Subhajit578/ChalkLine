# Object storage. LocalStack locally, Cloudflare R2 or AWS S3 in production -
# the same code reads all three, so switching providers is this file and
# nothing else. See src/storage.ts for the per-provider values.
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_BUCKET=whiteboard-images
# LocalStack accepts any credentials; R2 and S3 want real ones
STORAGE_ACCESS_KEY_ID=test
STORAGE_SECRET_ACCESS_KEY=test
# where browsers read objects from; a CDN domain in production
STORAGE_PUBLIC_BASE=http://localhost:4566/whiteboard-images

# ---- Required in production. `pnpm dev` sets NODE_ENV=development, which is
# ---- the only thing that lets these fall back to local defaults.

# Signs every session token. Must be identical in ws-backend, or tokens sign
# fine here and fail to verify there. At least 32 characters:
#   openssl rand -hex 32
# JWT_SECRET=

# The site's origin(s), comma separated. Also required by ws-backend.
# ALLOWED_ORIGINS=https://app.example.com

# Set by the host in production; the database itself is configured in
# packages/db-package/.env.example (DATABASE_URL and DIRECT_URL).
# NODE_ENV=production
# PORT=3001

# Proxies between the internet and this process, so rate limits see the real
# client IP. Defaults to 1 in production and 0 otherwise.
# TRUST_PROXY=1
