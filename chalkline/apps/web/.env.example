# Where the browser reaches the API and the socket server. Both are baked into
# the bundle at build time, so they must be set when `next build` runs, not
# only when the server starts. Production needs https:// and wss://.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Where the browser reads uploaded images from. Points at local object storage
# in development, and at the CDN domain in front of the bucket in production.
# Public by design - it is a location, not a credential.
NEXT_PUBLIC_STORAGE_PUBLIC_BASE=http://localhost:4566/whiteboard-images
