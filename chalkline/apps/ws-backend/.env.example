# Everything here is optional in development: `pnpm dev` sets
# NODE_ENV=development, which lets each of these fall back to a local default.
# In production the first two are required and the server refuses to start
# without them.

# Must be identical to http-backend's, or tokens it signs fail to verify here.
# JWT_SECRET=

# The site's origin(s), comma separated. A browser page from anywhere else is
# refused before the socket opens.
# ALLOWED_ORIGINS=https://app.example.com

# Set by the host in production. The database is configured in
# packages/db-package/.env.example.
# NODE_ENV=production
# PORT=8080
